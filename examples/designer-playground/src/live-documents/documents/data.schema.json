{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["boutiques"],
  "additionalProperties": false,
  "properties": {
    "boutiques": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/boutique" }
    }
  },
  "$defs": {
    "boutique": {
      "type": "object",
      "required": ["id", "boutique", "ventes", "objectif"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "boutique": { "type": "string", "minLength": 1 },
        "ventes": { "type": "integer", "minimum": 0 },
        "objectif": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
