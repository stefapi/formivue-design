{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@formivue/*": ["./*/src"]
    },
    "esModuleInterop": true,
    "strict": false,
    "noEmit": true,
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noUnusedLocals": false,
    "types": []
  },
  "include": ["*/src/**/*"],
  "exclude": ["**/__tests__/**"]
}
